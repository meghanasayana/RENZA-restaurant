DATABASE_URL="postgresql://user:password@host/renza?sslmode=require"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
JWT_SECRET="your-secure-jwt-secret-here"
PORT=5000
FRONTEND_URL="http://localhost:3001,http://localhost:3002,http://localhost:3003"
BACKEND_URL="http://localhost:5000"
CUSTOMER_URL="http://localhost:3003"

# Super Admin Initial Account
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@yourdomain.com"
SUPER_ADMIN_PASSWORD="your-strong-password"

# Cloudinary Image Storage (Free tier at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"



# Dish descriptions. A Groq API key (https://console.groq.com/keys).
# Without it, descriptions fall back to a local Ollama model, which is not
# present on a server - so the feature will not work. Menu import does not
# need this.
DESCRIPTION_API_KEY=

# Optional. The default model is openai/gpt-oss-20b. Groq retired the previous
# default in August 2026 and every request failed until it was changed, so if
# descriptions stop working, check https://console.groq.com/docs/deprecations
# and set the replacement here.
# DESCRIPTION_API_MODEL=openai/gpt-oss-20b
